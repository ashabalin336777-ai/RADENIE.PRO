# ===========================================
# RADENIE.PRO — шаблон переменных окружения
# Скопируйте в .env и заполните значения:
#   cp .env.example .env
# ===========================================

# --- Обязательно ---
SESSION_SECRET=change-me-to-a-long-random-secret-string-min-32-chars
# Локально без SSL: 8080. На VPS с HTTPS порты 80/443 заданы в docker-compose
PUBLIC_PORT=80

# Auth (NextAuth.js)
NEXTAUTH_SECRET=change-me-to-a-long-random-secret-string-min-32-chars
# Локально (Docker): http://localhost:8080
# Локально (npm run dev): http://localhost:3000
# VPS / прод с SSL:  https://radenie.pro
NEXTAUTH_URL=https://radenie.pro

# Аварийный сброс пароля admin (только на время фикса, потом =0)
ALLOW_ADMIN_RESET=0
ADMIN_RESET_TOKEN=

# На VPS (2GB) лучше НЕ собирать Next локально — pull готового образа из GHCR:
# FRONTEND_IMAGE=ghcr.io/ashabalin336777-ai/radenie-pro-frontend:latest
FRONTEND_IMAGE=

# --- AI ---
# Вариант A (рекомендуется для РФ): ключ с https://vsellm.ru
VSELLM_API_KEY=

# Вариант B: прямой ключ OpenAI (sk-proj-...) — работает без VseLLM
OPENAI_API_KEY=

VSELLM_BASE_URL=https://api.vsellm.ru/v1
VSELLM_MODEL=openai/gpt-4o-mini

# --- Приложение ---
NEXT_PUBLIC_API_URL=/api

# --- PostgreSQL ---
# Локально (вне Docker): localhost. В Docker Compose frontend/backend
# переопределяют URL на postgres:5432
DATABASE_URL=postgresql://radenie:radenie_secret@localhost:5432/radenie_pro
